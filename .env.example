# ==========================================
# Vercel Environment Variables 설정 안내
# ==========================================
# ⚠️ 주의: 여행 플래너(SUPABASE_URL)와 달리 Expo 웹앱은 'EXPO_PUBLIC_' 접두사가 필수입니다.
# ⚠️ 중요: Vercel 대시보드 등록/수정 후 반드시 [Deployments]에서 최신 빌드를 [Redeploy] 하셔야 적용됩니다.
#          (Expo Web은 빌드 시점에 환경변수가 클라이언트 JS 번들에 정적으로 주입됩니다.)

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# (선택) 관리자 금고 솔트 PIN SHA-256 해시 (기본 해시 내장되어 있으므로 미설정 시 기본값 동작)
EXPO_PUBLIC_ADMIN_PIN_HASH=1e9209557e240eb689d3c37a9340259f736fd76e198b80b32703a4af5fea9e67
